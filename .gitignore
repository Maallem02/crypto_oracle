# Environment variables — never commit real credentials
.env
.env.*
.env.local
.env.*.local

# Python virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / build
dist/
build/
*.egg-info/

# Database files
*.db
*.sqlite3

# Logs
*.log
*.log.err
*.err
history.txt

# Backups / one-off archives — bulky, regenerable, no code value
*.bak_*
archive_*.jsonl.gz

# Study intermediates — rewritten by the study scripts that produce them
gate_study_rows.csv

# ML model binary (large file)
*.pkl

# IDE
.vscode/
.idea/
*.swp
*.swo

# Watchdog runtime state — local to this machine, never shared
watchdog.log
watchdog_state.json
watchdog.disabled

# Persistent risk state (peak equity, daily window) — tied to one MT5 account
features/trading/risk_state.json
features/trading/risk_state.json.tmp

# Volume Profile bot on/off state — machine-local
features/volume_profile/vp_state.json

# Binance public 1-minute history for the VP long-history study (regenerable download, ~150 MB)
data/binance_1m/
# VP gold/USDJPY Exness M5 study outputs (regenerable by vp_exness_m5_study.py)
data/vp_exness_m5_*
data/vp_gold_3y_*
data/trend_following_out.txt
data/trend_robustness_out.txt
data/markov_regime_out.txt
data/multi_d1/
data/multi_market_*
