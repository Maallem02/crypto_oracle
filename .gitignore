# Environment variables — never commit real credentials
.env
.env.*
.env.local
.env.*.local

# Python virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / build
dist/
build/
*.egg-info/

# Database files
*.db
*.sqlite3

# Logs
*.log
*.log.err
*.err
history.txt

# Backups / one-off archives — bulky, regenerable, no code value
*.bak_*
archive_*.jsonl.gz

# Study intermediates — rewritten by the study scripts that produce them
gate_study_rows.csv

# ML model binary (large file)
*.pkl

# IDE
.vscode/
.idea/
*.swp
*.swo
